# Endereço da UNIDADE (a unidade vem do host): matriz = https://cardapio.banguelas.com.br
ERP_URL=https://cardapio.banguelas.com.br

# Chave da unidade — gerar no servidor: npx tsx scripts/print-agent-key.ts matriz
PRINT_AGENT_KEY=

# epson (maioria: Elgin, Bematech, Epson, Tanca, Daruma) | star
PRINTER_TYPE=epson

# Windows: compartilhe a impressora (nome curto, sem espaços) e use share:
PRINTER_INTERFACE=share:BANGUELAS
# Rede:  PRINTER_INTERFACE=tcp://192.168.1.100:9100
# USB (Linux/macOS): PRINTER_INTERFACE=usb://0x04b8:0x0202

# 32 = bobina de 58mm | 48 = bobina de 80mm
PRINTER_WIDTH=48

# Segundos entre tentativas quando a impressora falha
RETRY_SECONDS=20
