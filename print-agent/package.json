{
  "name": "banguelas-print-agent",
  "version": "1.0.0",
  "description": "Local agent — subscribes to ERP SSE and prints orders via ESC/POS thermal printer",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build:exe": "bash build-exe.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "eventsource": "^2.0.2",
    "node-fetch": "^3.3.2",
    "node-thermal-printer": "^4.3.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.2"
  },
  "bin": "index.js",
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist",
    "assets": []
  }
}
